p://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"sanction"},{"@language":"de","@value":"Strafe"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Detention","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#ProceedingPart"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"detention"},{"@language":"de","@value":"Haft"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Offence","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#ProceedingPart"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"offence"},{"@language":"de","@value":"Tat"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#ProceedingPart","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.cidoc-crm.org/cidoc-crm/E7_Activity"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"part of a proceeding"},{"@language":"de","@value":"Verfahrensteil"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#UrfehdeProceeding","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://gams.uni-graz.at/o:gams-ontology#Event"},{"@id":"http://www.cidoc-crm.org/cidoc-crm/E7_Activity"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Urfehde proceeding"},{"@language":"de","@value":"Urfehdeverfahren"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#fortsetzung","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A fragment that continues another entry and documents its proceeding (ADR-12)."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"continuation"},{"@language":"de","@value":"Fortsetzung"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#abgebrochen","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An entry the scribe broke off, after the editors' note."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"broken off"},{"@language":"de","@value":"abgebrochen"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#entwurf","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A draft on the inserted leaf 32a."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"draft"},{"@language":"de","@value":"Entwurf"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#aussage","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The statement of an accused person, which belongs to the proceeding of another entry."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"statement"},{"@language":"de","@value":"Aussage"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#urfehdbrief","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An Urfehde written as a letter in the first person."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"written oath of Urfehde"},{"@language":"de","@value":"Urfehdbrief"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#urfehde","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A regular Urfehde, dated or not."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"Urfehde"},{"@language":"de","@value":"Urfehde"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#EntryType","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Type of an entry after the introduction of the edition, which the TEI does not encode. The derivation assigns it by five rules on the editors' notes, the wording and the inserted leaf 32a, which reproduce research-artefacts/entry-types.tsv."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"entry type"},{"@language":"de","@value":"Eintragstyp"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#MarginalNote","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Claim of the Turmlöse, the guard entitled to the fee and the number of released prisoners, after Schmid 2016."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"marginal note"},{"@language":"de","@value":"Randnotiz"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Span","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://gams.uni-graz.at/o:gams-ontology#Text"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An annotated element of the TEI, the evidence of a derived node."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"text span"},{"@language":"de","@value":"Textstelle"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Page","http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"page"},{"@language":"de","@value":"Seite"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Entry","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://gams.uni-graz.at/o:gams-ontology#Text"},{"@id":"https://www.ica.org/standards/RiC/ontology#Record"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"One entry of the book, a regular Urfehde or a special entry."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"entry"},{"@language":"de","@value":"Eintrag"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Volume","http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://gams.uni-graz.at/o:gams-ontology#GAMSObject"},{"@id":"https://www.ica.org/standards/RiC/ontology#RecordSet"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"volume"},{"@language":"de","@value":"Band"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology","http://www.w3.org/2002/07/owl#versionInfo":[{"@value":"0.1"}],"http://purl.org/dc/terms/license":[{"@id":"https://creativecommons.org/licenses/by/4.0/"}],"http://purl.org/dc/terms/creator":[{"@value":"Christopher Pollin"}],"http://purl.org/dc/terms/description":[{"@language":"en","@value":"Domain model of the Urfehde proceedings in Urfehdebuch X (1563–1569), derived deterministically from the TEI of the edition."}],"http://www.w3.org/2000/01/rdf-schema#lab