[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#derivedFrom","http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.w3.org/ns/prov#wasDerivedFrom"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://gams.uni-graz.at/o:gams-ontology#Text"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The evidence is a text span, or the entry itself for a proceeding and for an amount outside any annotated element. Both are gams:Text."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"derived from"},{"@language":"de","@value":"abgeleitet aus"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#category","http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.cidoc-crm.org/cidoc-crm/P2_has_type"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2004/02/skos/core#Concept"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The concept of the taxonomy Urfehdekodierung a node was coded with."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"category"},{"@language":"de","@value":"Kategorie"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#unitAsWritten","http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.cidoc-crm.org/cidoc-crm/P180_has_currency"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#CurrencyUnit"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#MonetaryAmount"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"unit as written"},{"@language":"de","@value":"Einheit wie geschrieben"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#quantity","http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.cidoc-crm.org/cidoc-crm/P181_has_amount"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#MonetaryAmount"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"quantity"},{"@language":"de","@value":"Menge"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#duration","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#duration"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"duration"},{"@language":"de","@value":"Dauer"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#calendar","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Calendar"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"calendar"},{"@language":"de","@value":"Kalender"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#deedAfterOath","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The coded date of a deed lies after the Urfehde date of its entry."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"deed after the oath"},{"@language":"de","@value":"Tat nach der Urfehde"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#yearOutsideBook","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The coded year lies outside the sixteenth century."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"year outside the book"},{"@language":"de","@value":"Jahr ausserhalb des Buchs"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#writtenDateDiffers","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The written date differs from the coded one, and no written weekday decides between them."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"written date differs"},{"@language":"de","@value":"geschriebenes Datum weicht ab"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#codedDateConfirmed","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The written date differs from the coded one, and the written weekday falls on the coded date."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"coded date confirmed by the weekday"},{"@language":"de","@value":"codiertes Datum durch Wochentag bestätigt"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#writtenDateConfirmed","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The written date differs from the coded one, and the written weekday falls on the written date."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"written date confirmed by its weekday"},{"@language":"de","@value":"geschriebenes Datum durch Wochentag bestätigt"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A kind of contradiction between a coded date and its written form, read with the Julian weekday of the written date."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"date conflict"},{"@language":"de","@value":"Datumswiderspruch"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#Class"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#dateConflict","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"How the coded date contradicts its written form or its entry. The published value stays, ADR-06."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"date conflict"},{"@language":"de","@value":"Datumswiderspruch"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#dateSuggested","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"A date beside the published value where @when contradicts the written form (knowledge/data.md#data-quality): the written date where its weekday confirms it, or, for a year outside the sixteenth century, the coded day and month in the year that puts a deed before and a deadline after the Urfehde of the entry."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"suggested date"},{"@language":"de","@value":"vorgeschlagenes Datum"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#dateAsCoded","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The @when of the TEI as published, in the calendar named by ufbas-ont:calendar, not an xsd:date, which assumes the Gregorian calendar."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"date as coded"},{"@language":"de","@value":"Datum wie codiert"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#possiblySameAs","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"Candidate link from an editors' cross-reference, never owl:sameAs and not transitive. It joins the person the note names in its entry with the person of that name in the entry the note cites, where both names match the name of the note. Stated in the direction of the note."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"possibly the same person as"},{"@language":"de","@value":"möglicherweise dieselbe Person"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#SymmetricProperty"},{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#placeName","http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://gams.uni-graz.at/o:gams-ontology#hasName"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Place"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"The modern name the place list of the TEI gives a place."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"place name"},{"@language":"de","@value":"Ortsname"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#placeAsWritten","http://www.w3.org/2000/01/rdf-schema#comment":[{"@language":"en","@value":"An origin, residence or place of deed without a reference into the place list, as the text writes it."}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"place as written"},{"@language":"de","@value":"Ort wie geschrieben"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#DatatypeProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#residence","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Place"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@language":"en","@value":"residence"},{"@language":"de","@value":"Wohnort"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://www.w3.org/2002/07/owl#ObjectProperty"}]},{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#origin","http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#Place"}],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"https://gams.uni-graz.at/o:ufbas.ontology#