<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:its="http://www.w3.org/2005/11/its">
	<Entry xmlns="https://gams.uni-graz.at/o:ufbas.ontology#" rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-0">
		<textualContent xmlns="http://gams.uni-graz.at/o:gams-ontology#">Steck - 1 Bastean Doldter der kupfferschmidt burger inn mindren Basell Demnach er und Hanns Üle der waffenschmidt, von Lorentzen dem scherer am vischmerckt hundert pfundt entlehnet und imme zwey hüser ingsetzt, hat er uff dem einen huss hundert pfundt verschwygen, als man im auch desshalben für recht gebotten, hatt er den amptlüthen zuo antwort geben, wann man im schon piete so wölle er nit kommen, dorumb er inn gfenckniss gleyt und uff sontag den dritten tag jenners ditz 63 jors, mit gmeyner urphet gnediglichen wider usglossen, hatt dorby auch geschworen das er inn monats frist nechtkünfftig den bemelten scherer anclagbar machen, und wann man im hinfürt für gericht oder rhat bütet, das er gehörig und gehorsam sin solle. Niclaus Im Hoff Notarius subscripsit</textualContent>
		<isPartOf xmlns="http://gams.uni-graz.at/o:gams-ontology#" rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdebuch-X"/>
		<onPage xmlns="https://gams.uni-graz.at/o:ufbas.ontology#" rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#page-1r"/>
		<entryType xmlns="https://gams.uni-graz.at/o:ufbas.ontology#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#urfehde"/>
		<documents xmlns="https://gams.uni-graz.at/o:ufbas.ontology#" rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#proceeding-Eintrag-0"/>
		<mentionsPlace xmlns="https://gams.uni-graz.at/o:ufbas.ontology#" rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Kleinbasel"/>
	</Entry>
