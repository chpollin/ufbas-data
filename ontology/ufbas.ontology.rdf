		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">detention</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Haft</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#Offence">
