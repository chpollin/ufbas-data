<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:its="http://www.w3.org/2005/11/its">
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#derivedFrom">
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://gams.uni-graz.at/o:gams-ontology#Text"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The evidence is a text span, or the entry itself for a proceeding and for an amount outside any annotated element. Both are gams:Text.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">derived from</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">abgeleitet aus</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#category">
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The concept of the taxonomy Urfehdekodierung a node was coded with.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">category</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Kategorie</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#unitAsWritten">
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P180_has_currency"/>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#CurrencyUnit"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#MonetaryAmount"/>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">unit as written</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Einheit wie geschrieben</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#quantity">
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P181_has_amount"/>
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#MonetaryAmount"/>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">quantity</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Menge</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#duration">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"/>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">duration</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Dauer</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#calendar">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#Calendar"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"/>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">calendar</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Kalender</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#deedAfterOath">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The coded date of a deed lies after the Urfehde date of its entry.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">deed after the oath</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Tat nach der Urfehde</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#yearOutsideBook">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The coded year lies outside the sixteenth century.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">year outside the book</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Jahr ausserhalb des Buchs</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#writtenDateDiffers">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The written date differs from the coded one, and no written weekday decides between them.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">written date differs</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">geschriebenes Datum weicht ab</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#codedDateConfirmed">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The written date differs from the coded one, and the written weekday falls on the coded date.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">coded date confirmed by the weekday</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">codiertes Datum durch Wochentag bestätigt</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#writtenDateConfirmed">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The written date differs from the coded one, and the written weekday falls on the written date.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">written date confirmed by its weekday</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">geschriebenes Datum durch Wochentag bestätigt</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A kind of contradiction between a coded date and its written form, read with the Julian weekday of the written date.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">date conflict</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Datumswiderspruch</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#dateConflict">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#DateConflict"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">How the coded date contradicts its written form or its entry. The published value stays, ADR-06.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">date conflict</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Datumswiderspruch</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#dateSuggested">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A date beside the published value where @when contradicts the written form (knowledge/data.md#data-quality): the written date where its weekday confirms it, or, for a year outside the sixteenth century, the coded day and month in the year that puts a deed before and a deadline after the Urfehde of the entry.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">suggested date</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">vorgeschlagenes Datum</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#dateAsCoded">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#TimeSpan"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The @when of the TEI as published, in the calendar named by ufbas-ont:calendar, not an xsd:date, which assumes the Gregorian calendar.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">date as coded</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Datum wie codiert</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#possiblySameAs">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Candidate link from an editors&apos; cross-reference, never owl:sameAs and not transitive. It joins the person the note names in its entry with the person of that name in the entry the note cites, where both names match the name of the note. Stated in the direction of the note.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">possibly the same person as</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">möglicherweise dieselbe Person</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#placeName">
		<subPropertyOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://gams.uni-graz.at/o:gams-ontology#hasName"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#Place"/>
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The modern name the place list of the TEI gives a place.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">place name</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Ortsname</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#placeAsWritten">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An origin, residence or place of deed without a reference into the place list, as the text writes it.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">place as written</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Ort wie geschrieben</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#residence">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#Place"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"/>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">residence</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Wohnort</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#origin">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#Place"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"/>
