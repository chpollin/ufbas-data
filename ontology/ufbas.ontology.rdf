	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#gender">
		<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#Gender"/>
		<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#PersonMention"/>
