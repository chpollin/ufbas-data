		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">part of a proceeding</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Verfahrensteil</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#UrfehdeProceeding">
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://gams.uni-graz.at/o:gams-ontology#Event"/>
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Urfehde proceeding</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Urfehdeverfahren</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#fortsetzung">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A fragment that continues another entry and documents its proceeding (ADR-12).</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">continuation</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Fortsetzung</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#EntryType"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#abgebrochen">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An entry the scribe broke off, after the editors&apos; note.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">broken off</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">abgebrochen</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#EntryType"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#entwurf">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A draft on the inserted leaf 32a.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">draft</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Entwurf</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#EntryType"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#aussage">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">The statement of an accused person, which belongs to the proceeding of another entry.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">statement</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Aussage</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#EntryType"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#urfehdbrief">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">An Urfehde written as a letter in the first person.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">written oath of Urfehde</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Urfehdbrief</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#EntryType"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#urfehde">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">A regular Urfehde, dated or not.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Urfehde</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Urfehde</label>
		<rdf:type rdf:resource="https://gams.uni-graz.at/o:ufbas.ontology#EntryType"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#EntryType">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Type of an entry after the introduction of the edition, which the TEI does not encode. The derivation assigns it by five rules on the editors&apos; notes, the wording and the inserted leaf 32a, which reproduce research-artefacts/entry-types.tsv.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">entry type</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Eintragstyp</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#MarginalNote">
		<comment xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">Claim of the Turmlöse, the guard entitled to the fee and the number of released prisoners, after Schmid 2016.</comment>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="en">marginal note</label>
		<label xmlns="http://www.w3.org/2000/01/rdf-schema#" xml:lang="de">Randnotiz</label>
		<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	</rdf:Description>
	<rdf:Description rdf:about="https://gams.uni-graz.at/o:ufbas.ontology#Span">
		<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://gams.uni-graz.at/o:gams-ontology#Text"/>
