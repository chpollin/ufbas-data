# Eintrag-0 of tei/ufbas.1563.xml in the target model of the refactored RDF
# (knowledge/domain.md#domain-ontology), written by hand from the TEI and not generated by
# ufbas-TORDF-ontology.xsl, so it checks the shapes independently of the derivation. It
# follows the IRI scheme of the derivation: a lower-case class prefix and the xml:id of
# the element the node is derived from, amounts numbered within that element.
#
# Every value is taken from the div xml:id="Eintrag-0". Texts are the annotated elements
# with notes left out, ex expanded, lb as a space, lb break="no" joined, the metamark as a
# space and whitespace collapsed. The entry text keeps the marginal note of the manuscript,
# "Steck - 1", where it stands, and the marginal note is also its own MarginalNote. The
# entry names one place of the place list, Kleinbasel. Folio 1r is the first page break, image 19 from its @facs. Date and
# duration are @when and @dur, the amounts @quantity and @unit of the two measures. The
# volume is named after msName "Urfehdenbuch X", the residence "mindren Basell" is the
# listed place Kleinbasel, the residence "vischmerckt" without @ref a place of its mention.
# The entry is a regular Urfehde, with a date, an oath and a notarial subscription.
# What the TEI leaves open stays out: the offender of each offence and the person the
# sanction applies to, since the entry names an offender and an accomplice.

@prefix ufbas:     <http://gams.uni-graz.at/o:ufbas.1563#> .
@prefix ufbas-ont: <https://gams.uni-graz.at/o:ufbas.ontology#> .
@prefix ufbas-kat: <http://gams.uni-graz.at/ufbas/#> .
@prefix gams:      <http://gams.uni-graz.at/o:gams-ontology#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

ufbas:Urfehdebuch-X a ufbas-ont:Volume .

ufbas:Eintrag-0 a ufbas-ont:Entry ;
    gams:textualContent "Steck - 1 Bastean Doldter der kupfferschmidt burger inn mindren Basell Demnach er und Hanns Üle der waffenschmidt, von Lorentzen dem scherer am vischmerckt hundert pfundt entlehnet und imme zwey hüser ingsetzt, hat er uff dem einen huss hundert pfundt verschwygen, als man im auch desshalben für recht gebotten, hatt er den amptlüthen zuo antwort geben, wann man im schon piete so wölle er nit kommen, dorumb er inn gfenckniss gleyt und uff sontag den dritten tag jenners ditz 63 jors, mit gmeyner urphet gnediglichen wider usglossen, hatt dorby auch geschworen das er inn monats frist nechtkünfftig den bemelten scherer anclagbar machen, und wann man im hinfürt für gericht oder rhat bütet, das er gehörig und gehorsam sin solle. Niclaus Im Hoff Notarius subscripsit" ;
    gams:isPartOf ufbas:Urfehdebuch-X ;
    ufbas-ont:onPage ufbas:page-1r ;
    ufbas-ont:entryType ufbas-ont:urfehde ;
    ufbas-ont:documents ufbas:proceeding-Eintrag-0 ;
    ufbas-ont:hasMarginalNote ufbas:marginalnote-SchlagwortRatsknecht-0 ;
    ufbas-ont:mentionsPlace ufbas:Kleinbasel .

ufbas:page-1r a ufbas-ont:Page ;
    ufbas-ont:folio "1r" ;
    ufbas-ont:imageNumber 19 ;
    gams:isPartOf ufbas:Urfehdebuch-X .

# proceeding

ufbas:proceeding-Eintrag-0 a ufbas-ont:UrfehdeProceeding ;
    ufbas-ont:hasPart ufbas:offence-TatBetrug-0 , ufbas:offence-TatUngehorsam-0 , ufbas:detention-Untersuchungshaft-0 ,
        ufbas:oath-Urfehdeeid-0 , ufbas:sanction-StrafeErmahnung-0 ;
    ufbas-ont:hasOffender ufbas:person-PersonTäter-0 ;
    ufbas-ont:hasAccomplice ufbas:person-PersonMittäter-0 ;
    ufbas-ont:hasVictim ufbas:person-PersonOpfer-0 ;
    ufbas-ont:hasNotary ufbas:person-PersonNotar-0 ;
    ufbas-ont:derivedFrom ufbas:Eintrag-0 .

ufbas:offence-TatBetrug-0 a ufbas-ont:Offence ;
    ufbas-ont:category ufbas-kat:TatBetrug ;
    ufbas-ont:concerns ufbas:amount-TatBetrug-0-1 ;
    ufbas-ont:derivedFrom ufbas:TatBetrug-0 .

ufbas:offence-TatUngehorsam-0 a ufbas-ont:Offence ;
    ufbas-ont:category ufbas-kat:TatUngehorsam ;
    ufbas-ont:derivedFrom ufbas:TatUngehorsam-0 .

ufbas:detention-Untersuchungshaft-0 a ufbas-ont:Detention ;
    ufbas-ont:category ufbas-kat:Untersuchungshaft ;
    ufbas-ont:derivedFrom ufbas:Untersuchungshaft-0 .

# the Urfehde date belongs to the oath, the single one of the entry
ufbas:oath-Urfehdeeid-0 a ufbas-ont:Oath ;
    ufbas-ont:category ufbas-kat:Urfehdeeid ;
    ufbas-ont:hasTimeSpan ufbas:time-DatumUrfehde-0 ;
    ufbas-ont:derivedFrom ufbas:Urfehdeeid-0 .

ufbas:sanction-StrafeErmahnung-0 a ufbas-ont:Sanction ;
    ufbas-ont:category ufbas-kat:StrafeErmahnung ;
    ufbas-ont:deadline ufbas:time-DatumFrist-0 ;
    ufbas-ont:derivedFrom ufbas:StrafeErmahnung-0 .

# persons, each with the text of its persName as written

ufbas:person-PersonTäter-0 a ufbas-ont:PersonMention ;
    ufbas-ont:category ufbas-kat:PersonTäter ;
    ufbas-ont:nameAsWritten "Bastean Doldter der kupfferschmidt burger inn mindren Basell" ;
    ufbas-ont:forename "Bastean" ;
    ufbas-ont:surname "Doldter" ;
    ufbas-ont:gender ufbas-ont:male ;
    ufbas-ont:occupation "kupfferschmidt" ;
    ufbas-ont:status "burger" ;
    ufbas-ont:residence ufbas:Kleinbasel ;
    ufbas-ont:derivedFrom ufbas:PersonTäter-0 .

ufbas:person-PersonMittäter-0 a ufbas-ont:PersonMention ;
    ufbas-ont:category ufbas-kat:PersonMittäter ;
    ufbas-ont:nameAsWritten "Hanns Üle der waffenschmidt" ;
    ufbas-ont:forename "Hanns" ;
    ufbas-ont:surname "Üle" ;
    ufbas-ont:gender ufbas-ont:male ;
    ufbas-ont:occupation "waffenschmidt" ;
    ufbas-ont:derivedFrom ufbas:PersonMittäter-0 .

ufbas:person-PersonOpfer-0 a ufbas-ont:PersonMention ;
    ufbas-ont:category ufbas-kat:PersonOpfer ;
    ufbas-ont:nameAsWritten "Lorentzen dem scherer am vischmerckt" ;
    ufbas-ont:forename "Lorentzen" ;
    ufbas-ont:gender ufbas-ont:male ;
    ufbas-ont:occupation "scherer" ;
    ufbas-ont:residence ufbas:place-OrtWohnort-1 ;
    ufbas-ont:derivedFrom ufbas:PersonOpfer-0 .

ufbas:person-PersonNotar-0 a ufbas-ont:PersonMention ;
    ufbas-ont:category ufbas-kat:PersonNotar ;
    ufbas-ont:nameAsWritten "Niclaus Im Hoff Notarius" ;
    ufbas-ont:forename "Niclaus" ;
    ufbas-ont:surname "Im Hoff" ;
    ufbas-ont:gender ufbas-ont:male ;
    ufbas-ont:occupation "Notarius" ;
    ufbas-ont:derivedFrom ufbas:PersonNotar-0 .

# the guard of the marginal note, a keyword on a persName
ufbas:person-SchlagwortRatsknecht-0 a ufbas-ont:PersonMention ;
    ufbas-ont:category ufbas-kat:SchlagwortRatsknecht ;
    ufbas-ont:nameAsWritten "Steck" ;
    ufbas-ont:derivedFrom ufbas:SchlagwortRatsknecht-0 .

# places

ufbas:Kleinbasel a ufbas-ont:Place ;
    ufbas-ont:placeName "Kleinbasel" .

ufbas:place-OrtWohnort-1 a ufbas-ont:Place ;
    ufbas-ont:placeAsWritten "vischmerckt" ;
    ufbas-ont:derivedFrom ufbas:OrtWohnort-1 .

# marginal note, time, money

ufbas:marginalnote-SchlagwortRatsknecht-0 a ufbas-ont:MarginalNote ;
    ufbas-ont:claimant ufbas:person-SchlagwortRatsknecht-0 ;
    ufbas-ont:releasedCount "1"^^xsd:nonNegativeInteger ;
    ufbas-ont:derivedFrom ufbas:Eingangsnotiz-0 .

ufbas:time-DatumUrfehde-0 a ufbas-ont:TimeSpan ;
    ufbas-ont:category ufbas-kat:DatumUrfehde ;
    ufbas-ont:dateAsCoded "1563-01-03" ;
    ufbas-ont:calendar ufbas-ont:julian ;
    ufbas-ont:derivedFrom ufbas:DatumUrfehde-0 .

ufbas:time-DatumFrist-0 a ufbas-ont:TimeSpan ;
    ufbas-ont:category ufbas-kat:DatumFrist ;
    ufbas-ont:duration "P1M"^^xsd:duration ;
    ufbas-ont:derivedFrom ufbas:DatumFrist-0 .

ufbas:amount-TatBetrug-0-1 a ufbas-ont:MonetaryAmount ;
    ufbas-ont:quantity "100"^^xsd:decimal ;
    ufbas-ont:unitAsWritten ufbas-ont:unit-lbd ;
    ufbas-ont:derivedFrom ufbas:TatBetrug-0 .

# the loan inside the keyword Geldleihe, which no offence or sanction encloses
ufbas:amount-SchlagwortGeldleihe-0-1 a ufbas-ont:MonetaryAmount ;
    ufbas-ont:quantity "100"^^xsd:decimal ;
    ufbas-ont:unitAsWritten ufbas-ont:unit-lbd ;
    ufbas-ont:derivedFrom ufbas:SchlagwortGeldleihe-0 .

# spans, every element of the entry with @xml:id and @ana; the gender tokens on the forenames
# and the structural Eingangsnotiz give no category

ufbas:Eingangsnotiz-0 a ufbas-ont:Span ; gams:textualContent "Steck - 1" ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:SchlagwortRatsknecht-0 a ufbas-ont:Span ; gams:textualContent "Steck" ;
    ufbas-ont:category ufbas-kat:SchlagwortRatsknecht ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:PersonTäter-0 a ufbas-ont:Span ; gams:textualContent "Bastean Doldter der kupfferschmidt burger inn mindren Basell" ;
    ufbas-ont:category ufbas-kat:PersonTäter ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:male-0 a ufbas-ont:Span ; gams:textualContent "Bastean" ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Beruf-0 a ufbas-ont:Span ; gams:textualContent "kupfferschmidt" ;
    ufbas-ont:category ufbas-kat:Beruf ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Status-0 a ufbas-ont:Span ; gams:textualContent "burger" ;
    ufbas-ont:category ufbas-kat:Status ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:OrtWohnort-0 a ufbas-ont:Span ; gams:textualContent "mindren Basell" ;
    ufbas-ont:category ufbas-kat:OrtWohnort ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:PersonMittäter-0 a ufbas-ont:Span ; gams:textualContent "Hanns Üle der waffenschmidt" ;
    ufbas-ont:category ufbas-kat:PersonMittäter ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:male-1 a ufbas-ont:Span ; gams:textualContent "Hanns" ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Beruf-1 a ufbas-ont:Span ; gams:textualContent "waffenschmidt" ;
    ufbas-ont:category ufbas-kat:Beruf ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:PersonOpfer-0 a ufbas-ont:Span ; gams:textualContent "Lorentzen dem scherer am vischmerckt" ;
    ufbas-ont:category ufbas-kat:PersonOpfer ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:male-2 a ufbas-ont:Span ; gams:textualContent "Lorentzen" ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Beruf-2 a ufbas-ont:Span ; gams:textualContent "scherer" ;
    ufbas-ont:category ufbas-kat:Beruf ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:OrtWohnort-1 a ufbas-ont:Span ; gams:textualContent "vischmerckt" ;
    ufbas-ont:category ufbas-kat:OrtWohnort ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:SchlagwortGeldleihe-0 a ufbas-ont:Span ; gams:textualContent "hundert pfundt entlehnet" ;
    ufbas-ont:category ufbas-kat:SchlagwortGeldleihe ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:TatBetrug-0 a ufbas-ont:Span ; gams:textualContent "hundert pfundt verschwygen" ;
    ufbas-ont:category ufbas-kat:TatBetrug ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:TatUngehorsam-0 a ufbas-ont:Span ; gams:textualContent "wann man im schon piete so wölle er nit kommen" ;
    ufbas-ont:category ufbas-kat:TatUngehorsam ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Untersuchungshaft-0 a ufbas-ont:Span ; gams:textualContent "dorumb er inn gfenckniss gleyt" ;
    ufbas-ont:category ufbas-kat:Untersuchungshaft ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:DatumUrfehde-0 a ufbas-ont:Span ; gams:textualContent "sontag den dritten tag jenners ditz 63 jors" ;
    ufbas-ont:category ufbas-kat:DatumUrfehde ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Urfehdeeid-0 a ufbas-ont:Span ; gams:textualContent "mit gmeyner urphet gnediglichen wider usglossen" ;
    ufbas-ont:category ufbas-kat:Urfehdeeid ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:StrafeErmahnung-0 a ufbas-ont:Span ; gams:textualContent "das er inn monats frist nechtkünfftig den bemelten scherer anclagbar machen, und wann man im hinfürt für gericht oder rhat bütet, das er gehörig und gehorsam sin solle" ;
    ufbas-ont:category ufbas-kat:StrafeErmahnung ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
# the date ends inside a word, "fris" of "frist"
ufbas:DatumFrist-0 a ufbas-ont:Span ; gams:textualContent "inn monats fris" ;
    ufbas-ont:category ufbas-kat:DatumFrist ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:NotarialSubscription-0 a ufbas-ont:Span ; gams:textualContent "Niclaus Im Hoff Notarius subscripsit" ;
    ufbas-ont:category ufbas-kat:NotarialSubscription ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:PersonNotar-0 a ufbas-ont:Span ; gams:textualContent "Niclaus Im Hoff Notarius" ;
    ufbas-ont:category ufbas-kat:PersonNotar ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:male-3 a ufbas-ont:Span ; gams:textualContent "Niclaus" ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
ufbas:Beruf-3 a ufbas-ont:Span ; gams:textualContent "Notarius" ;
    ufbas-ont:category ufbas-kat:Beruf ;
    gams:isPartOf ufbas:Eintrag-0 ; ufbas-ont:onPage ufbas:page-1r .
