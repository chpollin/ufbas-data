7ten Novembris unnd inn dem jar obstadt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:DatumUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-604"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-604" /><tei:when>1569-11-07</tei:when></uf:DatumUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRat-393"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e77176" /><g2o:inhalt>Gnedigen Herren</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortRat rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRat-SchlagwortRat-393"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRat-393" /></uf:SchlagwortRat><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-765"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e77176" /><g2o:inhalt>Hanns Römcler der küffer burger zu Basell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-765"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-765" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Hanns</uf:forename><uf:surname>Römcler</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1137" /><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-133" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-765"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-765" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Hanns</uf:forename><uf:surname>Römcler</uf:surname><uf:hasBeruf rdf:resource="http://ga