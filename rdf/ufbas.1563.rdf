nTäter-549"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e57599" /><g2o:inhalt>Elsbeth Jackj von Bëtterlingen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-549"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-549" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Elsbeth</uf:forename><uf:surname>Jackj</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Payerne" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-549"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-549" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Elsbeth</uf:forename><uf:surname>Jackj</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Payerne" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-418"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e57599" /><g2o:inhalt>Bëtterlingen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Payerne"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-418" /></uf:OrtHerkunft><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Payerne"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-418" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortProstitution-19"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e57599" /><g2o:inhalt>gmeyne mëtz</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortProstitution rdf:about="http://gams.uni-graz.at