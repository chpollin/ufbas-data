lt>sich allher win und würtzhüseren müssigen solle</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeVerbotWirtshaus rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWirtshaus-StrafeVerbotWirtshaus-18"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWirtshaus-18" /></uf:StrafeVerbotWirtshaus><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-133"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e19403" /><g2o:inhalt>Niclauss Im Hoff</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-133"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-133" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-132" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-132"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e19403" /><g2o:inhalt>Niclauss Im Hoff</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-132"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-132" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-132"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-132" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-152"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e19403" /><g2o:inhalt>Berenhut Jacobunsichere Lesung Herr ein friheit allhie von wegen dz er sich mit wyn überladen und schweren übersechen in unser gnädiger herren ge fengnuss kommen, und uff dato mitt gemeiner urphe ussgelassen juravit ut moris</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-152"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-152" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-128" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-182" /><uf:hasTatAlkoholmissbrauch rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-TatAlkoholmissbrauch-19" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-135" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-144" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-140" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-128"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e19403" /><g2o:inhalt>Berenhut</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-128"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-128" /><uf:hasSchlagwortGefängnis rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-SchlagwortGefängnis-56" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-56"><g2o:appears-on rdf:res