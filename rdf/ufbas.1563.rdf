><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-18"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-18" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-55" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-18"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-18" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-55" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-55"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e3858" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-55"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-55" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-31"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e3858" /><g2o:inhalt>Toubhüsslj - 1 °Bastion Ëberlj von Erlach ein pflaster knecht, genant Schërtlj Demnach und er uff gestrigen Sontag vor dem richthuss mit obgenantem WilhelmenWilhelm Harburg kommt in einem anderen Urfehdeverfahren vor, siehe Urfehdeeintrag Wilhelm Harburg von Losanna ein taglöner (fol. 14 recto) für anderes Urfehdeverfahren ein zanck angfangen, denselben gschlagen und cretzt, und sonst vyl onruowen anfacht, ist er ins Toubhüsslin gleyt und uff Mentag den 26 Brachmonats ditz 64 jars, gnediglichen wider ussglossen, hatt den innhalt gmeyner urphet darby ouch geschworen das er sich von statt und landt Basell hinweg thuon, an andere ort und endt ziechen, und unser Gnedig Herren ongeirrt lossen solle. Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-31"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-31" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-12" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-34" /><uf:hasDatumTat rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumTat-DatumTat-4" /><uf:hasOrtTatort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-OrtTatort-23" /><uf:hasAnderesUrfehdeverfahren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfehdeverfahren-AnderesUrfehdeverfahren-3" /><uf:hasTatSchlägerei rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatSchlägerei-TatSchlägerei-2" /><uf:hasTatKörperverletzung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatKörperverletzung-TatKörperverletzung-3" /><uf:hasTatOrdnungsstörung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-TatOrdnungsstörung-2" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-22" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-25" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-24" /><uf:hasStrafeAusweisung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-StrafeAusweisung-11" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-19" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingan