 so er am im ghept, ire cleyder gon Michelfelden geschickt, ouch nochmalen selbs zuo iren gon Michelfelden gangen, mit iren ein anschlag gmacht und nochdemselben iren gon Crentzach noch zogen, dosselbst mit iren geessen und truncken</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatLeichtfertigkeit rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-TatLeichtfertigkeit-1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-1" /><uf:hasPerson rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-79" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Michelfelden" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Grenzach" /></uf:TatLeichtfertigkeit><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#persName-79"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e2499" /><g2o:inhalt>metzen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-79"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#persName-79" /><uf:hasSchlagwortProstitution rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortProstitution-SchlagwortProstitution-0" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortProstitution-0"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e2499" /><g2o:inhalt>metzen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortProstitution rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortProstitution-SchlagwortProstitution-0"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortProstitution-0" /></uf:SchlagwortProstitution><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#placeName-63"><g2o:appear