rs-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e2780" /><g2o:inhalt>geredt soll haben, wo er gfangen werde, so welle er denselben flecken anzünden</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatDrohung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDrohung-TatDrohung-2"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatDrohung-2" /></uf:TatDrohung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-6"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e2780" /><g2o:inhalt>ein lusch wyss par hosen zuo Rickenbach entwert soll han</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatDiebstahl rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-TatDiebstahl-6"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-6" /><uf:hasOrtTatort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Rickenbach" /></uf:TatDiebstahl><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-11"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e2780" /><g2o:inhalt>Rickenbach</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtTatort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Rickenbach"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-11" /></uf:OrtTatort><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Rickenbach"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-11" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-12"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e2780" /><g2o:inhalt>im Kilchzymmer</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtTatort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#O