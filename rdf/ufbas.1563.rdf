haben sy beyde übernacht inn gfenckniss legen lossen und yedes theyl umb zwen gulden gstrofft, von wegen das sy schympfflichen hinder dem wyn, mit der heyligen ee, umb gangen, sindt uff Mittwochen den 14 Jenners ditz 68 jors, mit gmeyner urphet, gnediglichen wider ussglossen. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-436"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-436" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-421" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-516" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-517" /><uf:hasVorinstanz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-65" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-131" /><uf:hasTatEhebruch rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatEhebruch-TatEhebruch-12" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-425" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-421" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-412" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-421"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e54350" /><g2o:inhalt>Uolin – 2</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-421"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz