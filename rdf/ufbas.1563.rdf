" /><uf:forename>Caspar</uf:forename><uf:surname>Bylling</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1096" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-1096"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e73757" /><g2o:inhalt>wynschenck</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1096"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-1096" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-49"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e73757" /><g2o:inhalt>für die Heymlichen Herren gepotten, ist er nit erschynen, und als im ein mal dry für ein Ersamen Rhat darumb gebotten, ist er allwegen onghorsam ussplyben</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatUngehorsam rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-TatUngehorsam-49"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-49" /><uf:hasSchlagwortHeimlicheHerren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortHeimlicheHerren-SchlagwortHeimlicheHerren-1" /><uf:hasSchlagwortRat rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRat-SchlagwortRat-369" /></uf:TatUngehorsam><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortHeimlicheHerren-1"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e73757" /><g2o:inhalt>Heymlichen Herren</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortHeimlicheHerren rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortHeimlicheHerren-SchlagwortHeimlicheHerren-1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortHei