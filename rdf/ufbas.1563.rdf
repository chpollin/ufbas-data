s-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e29782" /><g2o:inhalt>Niklaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-207"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-207" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-438" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-207"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-207" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-438" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-438"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e29782" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-438"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-438" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-228"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e29782" /><g2o:inhalt>Köferlj - 1 °Peter Schuoler von Bëttendorff. Demnoch und er MeisterLienharten Grass demseckler fünff seck kernen, yeden sack umb drü pfundt und 7 ß zekouffen geben, und der schouw kernen gar suber und hüpsch gsin. Als aber der müller den schouwkernen, gegen den andren kernen, der inn secken gsin, ghëpt, ist es wyss und schwartz gegen ein andren gsin, und den schouw kernen gar nit glych gsin. Desshalben er umb 2 lb gstrofft und übernacht inn gfenckniss gleyt, und hiemit uff Samb stag den 20 Octobris ditz 65 jors , mit gmeyner urphet die er geschworen, gnediglichen wider ussglossen . Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-228"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-228" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-208" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-270" /><uf:hasPerson rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-917" /><uf:hasTatBetrug rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatBetrug-TatBetrug-9" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-71" /><uf:hasStrafeGefängnis rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGefängnis-StrafeGefängnis-2" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-219" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-216" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-207" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-208"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e29782" /><g2o:inhalt>Köferlj - 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-208"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-208" /><uf:hasSchlagwortRatsknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.