nhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatOrdnungsstörung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-TatOrdnungsstörung-69"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-69" /></uf:TatOrdnungsstörung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWirtshaus-78"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e66989" /><g2o:inhalt>würtzhuss Zuom Ochsen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortWirtshaus rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWirtshaus-SchlagwortWirtshaus-78"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWirtshaus-78" /></uf:SchlagwortWirtshaus><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-41"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e66989" /><g2o:inhalt>Cammenthür von Lückeren</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonAnwesende rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-PersonAnwesende-41"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-41" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Cammenthür</uf:forename><uf:surname>von Lückeren</uf:surname></uf:PersonAnwesende><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonAnwesende-41"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-41" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Cammenthür</uf:forename><uf:surname>von Lückeren</uf:surname></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatGotteslästerung-26"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e66989" /><g2o:inhalt>disser tobet, Gott glestert</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatGotteslästerung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatGotteslästerung-TatGotteslästerung-26"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatGotteslästerung-26" /></uf:TatGotteslästerung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-70"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e66989" /><g2o:inhalt>gseyt, er habe zwen klötz, uff den Junckheren von Crentzach gladen, und vyl seltzamer reden tryben</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatOrdnungsstörung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-TatOrdnungsstörung-70"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-70" /></uf:TatOrdnungsstörung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatWiderstandgegenObrigkeit-26"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e66989" /><g2o:inhalt>als die von Riechen gfencklichen zuo im gryffen, hatt er sich gwert und gar lëtz, gestellt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatWiderstandgegenObrigkeit rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatWiderstandgegenObrigkeit-TatWiderstandgegenObrigkeit-26"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatWiderstandgegenObrigkeit-26" /></uf:TatWiderstandgegenObrigkeit><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-494"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e66989" /><g2o:inhalt>er gfencklichen harin gfürt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchung