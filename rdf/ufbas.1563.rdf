rsonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-324"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-324" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-662" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-662"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-662"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-662" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-346"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Bylger - 1 °Jocob Vögtlj uff einem hoff genant inn Rotteris by Gylgenberg sesshafft Demnach und er vor Spalen thor an offner strass, mit ettlichen taglöneren, inn alle drü gespylt, ist er durch die stattknecht ergriffen und inn gfenckniss gleyt, und uff Mentag den 23ten Septembris ditz 66 jars, mit gmeyner urphet gnediglichen wider ussglossen, und der stroff der fünff pfunden gelossen. Niclaus Im Hoff Notariussubscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-346"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-346" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-330" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-415" /><uf:hasOrtTatort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-OrtTatort-147" /><u