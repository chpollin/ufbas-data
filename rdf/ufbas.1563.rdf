><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>zween tag und zwo necht inn gfenckniss gleyt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-222"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-222" /></uf:Untersuchungshaft><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-76"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>umb 20 lb Basler werung ge strofft</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeGeldstrafe rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-76"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-76" /></uf:StrafeGeldstrafe><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-227"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>Mentag den 29 Octobris ditz 65 jors</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:DatumUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-227"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-227" /><tei:when>1565-10-29</tei:when></uf:DatumUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-224"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>mit gmeyner urphet gnediglichen wider ussglossen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Urfehdeeid rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-224"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-224" /></uf:Urfehdeeid><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWaffen-17"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>kein gwer weder tags noch nachts by noch an im tragen solle, dann allein ein abbrochen brotmesser</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeVerbotWaffen rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWaffen-StrafeVerbotWaffen-17"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWaffen-17" /></uf:StrafeVerbotWaffen><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWirtshaus-24"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>all zünfft und gsellschafften, würtz, wyn und kochshüser myden, nienen anderswo essen noch trincken dann inn sinem huss, und uff siner eeren zunfft zuo jars malen, und sonst inn botten und ver botten solle er siner zunfft gehorsam sin</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeVerbotWirtshaus rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWirtshaus-StrafeVerbotWirtshaus-24"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWirtshaus-24" /><uf:hasSchlagwortZunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-SchlagwortZunft-28" /><uf:hasStrafeErmahnung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-114" /><uf:hasSchlagwortZunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-SchlagwortZunft-30" /></uf:StrafeVerbotWirtshaus><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-28"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>zünfft</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></