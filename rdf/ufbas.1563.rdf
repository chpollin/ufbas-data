i-graz.at/o:ufbas.1563#Person-PersonMittäter-58"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonMittäter-58" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatBeleidigungVerleumdung-33"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38488" /><g2o:inhalt>und als der weybell darzuo kommen, hatt er in ein alten schelmen gscholten</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatBeleidigungVerleumdung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatBeleidigungVerleumdung-TatBeleidigungVerleumdung-33"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatBeleidigungVerleumdung-33" /><uf:hasPersonOpfer rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-139" /></uf:TatBeleidigungVerleumdung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-139"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38488" /><g2o:inhalt>weybell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonOpfer rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-139"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-139" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-578" /></uf:PersonOpfer><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonOpfer-139"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-139" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-578" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-578"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38488" /><g2o:inhalt>weybell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-