g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e36260" /><g2o:inhalt>Niclauss Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-259"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-259" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-546" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-259"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-259" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-546" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-546"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e36260" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-546"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-546" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-281"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e36260" /><g2o:inhalt>Köferlj -1 ° Crischion Salatj Clauss Spechten eefrow . Alsdann ir eeman untrüwlichen mit dem allmuossen umbgangen, darumb er dann von statt und landt verwyssen, ist sy als wann sy + ouch darumb wüssens ghept, merglichen verargwont, und desshalben ingleyt, und uff Sambstag den 16 des Mertzens diz 66ten jors mit gmeyner urphet gnediglichen wider ussglossen, hatt dorby ouch geschworen, das sy sich von statt und land Basell hinweg thuon, und dorin onerloupt nit kommen noch sich finden lassen solle. Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-281"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-281" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-262" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-336" /><uf:hasAnderesUrfehdeverfahren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfehdeverfahren-AnderesUrfehdeverfahren-21" /><uf:hasTatBeihilfe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatBeihilfe-TatBeihilfe-7" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-263" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-272" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-269" /><uf:hasStrafeAusweisung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-StrafeAusweisung-81" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-259" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-262"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e36260" /><g2o:inhalt>Köferlj -1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-262"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-262" /><uf:hasSchlagwortRatsknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Schlagwor