at/o:ufbas.1563#DatumUrfehde-372" /><tei:when>1567-08-27</tei:when></uf:DatumUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-368"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>mit gmeyner urphet, wider ussglossen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Urfehdeeid rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-368"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-368" /></uf:Urfehdeeid><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-360"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-360"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-360" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-361" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-361"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Niklaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-361"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-361" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-728" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-361"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-361" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-728" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-728"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-728"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-728" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-384"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Uolin – 1 ° Johannes Bachteler der probst im undren Collegio. Demnoch und er mit siner eefrowen übel und unfridsam lept, und als im dorumb für die Bannherren gepotten, ist er onghorsam ussplyben. Desshalben er inn gfenckniss gleyt und uff Sontag den 27 Julij ditz 67 jors, mit gmeyner urphet, gnediglichen wider ussglossen dorby er ouch geschworen wann man im hinfürter für die Bann herren oder sonst anderswo hyn, piethen wirt, das er gehorsam sin solle. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-384"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-384" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-368" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-461" /><uf:hasTatÜblesHaushalten rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatÜblesHaushalten-TatÜblesHaushalten-31" /><uf:hasTatUngehorsam rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-TatUngehorsam-31" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-358" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-373" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-369" /><uf:hasStrafeErmahnung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-171" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-361" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-368"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Uolin – 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-368"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-368" /><uf:hasSchlagwortStadtknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-114" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-114"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Uolin</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortStadtknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-114"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-114" /></uf:SchlagwortStadtknecht><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-SchlagwortStadtknecht-114"><oa:hasTarget rdf:resource="http://gams.uni-graz.