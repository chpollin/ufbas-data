tar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-557"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-557" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname> Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1083" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-557"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-557" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname> Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1083" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-1083"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e72332" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1083"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-1083" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-582"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e72332" /><g2o:inhalt>Uolin - 1 Brucker - 1 °Hans Heinrich Heytzman von °Basell, und Ursula Mog von Hüttwyl uss dem Thurgöw. Die Herren Eerichter haben sy beyde inn gfenckniss legen lossen, diewyl bemelte Ursula Mog, in der ee anspricht und er derselben gar nit geston wellen. Nochdem und aber er glych übernacht der sach anred, das er iren die ee verheyssen, sindt sy beyde mit gmeyner urphet, uff Fritag den dritten Junij ditz 69 jors, wider ledig glossen. Niclaus Im Hoff subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-582"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-582" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-594" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-595" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-708" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-709" /><uf:hasSchlagwortEhegerichtEherichter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortEhegerichtEherichter-SchlagwortEhegerichtEherichter-96" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-541" /><uf:hasTatBruchEheversprechen rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatBruchEheversprechen-TatBruchEheversprechen-10" /><uf:hasStrafeUrteilohneStrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeUrteilohneStrafe-StrafeUrteilohneStrafe-33" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-557" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-594"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e72332" /><g2o:inhalt>Uolin - 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-594"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-594" /><uf:hasSchlagwortStadtknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-175" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-175"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1