1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-361" /></uf:Urfehdeeid><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-353"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-353"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-353" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-354" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-354"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Niklaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-354"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-354" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-718" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-354"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-354" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-718" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-718"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-718"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-718" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-377"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Uolin – 1 ° Jocob Schwartz der stattknechtJocob Schwartz kommt in anderen Urfehdeverfahren vor, siehe UrfehdeeinträgeJocob Schwartz und Cuonrat Steiblj die stattknecht (fol. 37 verso), Jocob Schwartz der stattknecht (fol. 56 recto) und Jocob Schwartz der stattknecht (fol. 88 recto) für andere Urfehdeverfahren Diewyl er uff gestrigen Mittwochen, allein das ander zeichen inn rhat gelütet und das erst underlassen, ist er übernacht inn gfenckniss gleyt, und uff Donstag den 28 Augstmonats ditz 67 jars, mit gmeyner urphet gnediglichen wider usglossen, und im darby anzeigt, das er hinfürter sines diensts flyssiger warten solle. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-377"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-377" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-361" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-450" /><uf:hasTatArbeitsverweigerung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatArbeitsverweigerung-TatArbeitsverweigerung-0" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-351" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-366" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-362" /><uf:hasStrafeErmahnung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-170" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-354" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-361"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Uolin – 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-361"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-361" /><uf:hasSchlagwortStadtknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-110" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-110"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Uolin</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortStadtknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-110"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-110" /></uf:SchlagwortStadtknecht><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-SchlagwortStadtknecht-110"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-110" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-450"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Jocob Schwartz der stattknecht</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-450"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-450" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Jocob</uf:forename><uf:surname>Schwartz</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-719" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-450"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-450" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Jocob</uf:forename><uf:surname>Schwartz</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-719" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-719"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>stattknecht</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-719"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-719" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatArbeitsverweigerung-0"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e47649" /><g2o:inhalt>Diewyl er uff gestrigen Mittwochen, allein das ander zeichen inn rhat gelütet und das erst underlassen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatArbeitsverweigerung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatArbeitsverweigerung-TatArbeitsverweigerung-0"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatArbeitsverweigerung-0" /><uf:hasDatumTat rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumTat-DatumTat-55" /></uf:TatArbeitsverweigerung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumTat-55"><g2o: