o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortGefängnis rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-SchlagwortGefängnis-138"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-138" /></uf:SchlagwortGefängnis><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-489"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e51144" /><g2o:inhalt>Thomman Scherer von Langenthal uss Bern pieth</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-489"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-489" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Thomman</uf:forename><uf:surname>Scherer</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Langenthal" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-489"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-489" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Thomman</uf:forename><uf:surname>Scherer</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Langenthal" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-369"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e51144" /><g2o:inhalt>Langenthal uss Bern pieth</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Langenthal"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-369" /></uf:OrtHerkunft><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Langenthal"><oa:hasTarget rdf:re