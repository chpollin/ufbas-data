get rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-294" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-609" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-294"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-294" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-609" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-609"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e40454" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-609"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-609" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-316"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e40454" /><g2o:inhalt>Eselthurn – 2 °Hans Göüschell, der nochrichter und °Michell Vollmer, der nochrichter vonRinfelden Alsdann uff hüttigen tag zwen under plosem hymell berech tiget, haben diese nochrichter dieselben zwen armen menschen, by den stricken erwütscht, vor und ee, der vogt die umbfrog volls gethon, desshalben sy beydt vor Steinen thor uff der Walldstatt, so baldt sy die zwen mit dem schwert gerichtet, gfencklichen angnommen, und inn Eselthurn glegt. Sindt aber uff den oben desselben tags, uff Donstag den 20 Junij anno 66, mit gmeiner urphet gnediglichen wider ussglossen und yeder umb ein pfundt, gstrofft. Niclaus Im Hoff Notariussubscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-316"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-316" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-299" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-375" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-376" /><uf:hasTatUngetreueAmtsführung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUngetreueAmtsführung-TatUngetreueAmtsführung-14" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-295" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-306" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-304" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-95" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-294" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-299"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e40454" /><g2o:inhalt>Eselthurn – 2</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-299"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-299" /><uf:hasSchlagwortGefängnis rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-SchlagwortGefängnis-103" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-103"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#