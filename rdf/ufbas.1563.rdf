on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18561" /><g2o:inhalt>inen anzeigt, das sy wyther im rechten fürfaren sollen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeErmahnung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-65"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-65" /></uf:StrafeErmahnung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-130"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18561" /><g2o:inhalt>Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-130"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-130" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-129" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-129"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18561" /><g2o:inhalt>Niclauss Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-129"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-129" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-282" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-129"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-129" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-282" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-282"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18561" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-282"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-282" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-143"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18561" /><g2o:inhalt>Brucker - 1 Uolj - 1 ° Junckher Jonas Offemburg und ° Martha Holtzwartin von Costentz Die Herren Eerichter haben sy beyde noch geendeter rechtsfertigung übernacht inn gfenckniss legen lossen, und yedes theyl umb 5 lb gestrofft, von wegen der schnuory, die sy miteinandren getriben, sind uff Mittwochen den 15 May ditz 65 jars mit gmeyner urphet wider ledig glossen. Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-143"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-143" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-119" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-172" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-173" /><uf:hasSchlagwortEhegerichtEherichter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortEhegerichtEherichter-SchlagwortEhegerichtEherichter-24" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.