/g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-441"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-441" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff 
