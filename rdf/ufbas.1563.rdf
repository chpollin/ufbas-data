az.at/o:ufbas.1563#" /></rdf:Description><uf:TatVerbaleAuseinandersetzung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatVerbaleAuseinandersetzung-TatVerbaleAuseinandersetzung-0"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatVerbaleAuseinandersetzung-0" /></uf:TatVerbaleAuseinandersetzung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-1"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e3204" /><g2o:inhalt>alls man ouch im für die Bannherren gepotten, ist er nit erschinen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatUngehorsam rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-TatUngehorsam-1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-1" /><uf:hasSchlagwortBannherren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortBannherren-SchlagwortBannherren-0" /></uf:TatUngehorsam><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortBannherren-0"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e3204" /><g2o:inhalt>Bannherren</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortBannherren rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortBannherren-SchlagwortBannherren-0"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortBannherren-0" /></uf:SchlagwortBannherren><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-17"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e3204" /><g2o:inhalt>in gfengknus gleyt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-17"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-17" /></