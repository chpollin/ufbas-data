PartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:FrüheresUrfehdeverfahren rdf:about="http://gams.uni-graz.at/o:ufbas.1563#FrüheresUrfehdeverfahren-FrüheresUrfehdeverfahren-7"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#FrüheresUrfehdeverfahren-7" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Blotzheim" /></uf:FrüheresUrfehdeverfahren><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#placeName-155"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e7396" /><g2o:inhalt>Plotzhein</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Blotzheim"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#placeName-155" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatÜbertretungUrfehde-3"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e7396" /><g2o:inhalt>so hat doch er umb dieselb warnung so im anzeigt, wenig geben, sich wider hinuss inn die dörffer thon</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatÜbertretungUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatÜbertretungUrfehde-TatÜbertretungUrfehde-3"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatÜbertretungUrfehde-3" /><uf:hasOrtTatort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-OrtTatort-36" /></uf:TatÜbertretungUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-36"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e7396" /><g2o:inhalt>die dörffer</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtTatort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-OrtTatort-36"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTato