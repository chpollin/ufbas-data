"http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-411" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-252"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-252" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Jerg</uf:forename><uf:surname>Wydenman</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-411" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-411"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e27827" /><g2o:inhalt>büchsenschiffter</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-411"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-411" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-253"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e27827" /><g2o:inhalt>Melchior Marschalt der bantzermacher</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-253"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-253" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Melchior</uf:forename><uf:surname>Marschalt</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-412" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-253"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-253" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Melchior</uf:forename><uf:surname>Marschalt</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-