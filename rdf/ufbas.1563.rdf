out="http://gams.uni-graz.at/o:ufbas.1563#Beruf-769"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e50765" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-769"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-769" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-408"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e50765" /><g2o:inhalt>Hanss Rorer – 1 Uolin – 1 ° Hans Schoub von Lupssingen und ° Mergelin Schlosserj von Gelterkingen Die Herren Eerichter haben sy inn gfenckniss lossen legen, von wegen den schnuory, die sy miteinandren getryben und gemelten Hanssen Schoub umb + fünff pfundt gestrofft. Sindt uff Mittwochen den 15 des Octobris ditz 67 jors, mit gmeyner urphet wider ledig glossenn. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-408"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-408" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-392" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-393" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-486" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-487" /><uf:hasVorinstanz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-63" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-381" /><uf:hasTatUnzucht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUnzucht-TatUnzucht-46" /><uf:hasStrafeGeldstrafe r