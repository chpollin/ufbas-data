scription><uf:DatumUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-441"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-441" /><tei:when>1568-03-21</tei:when></uf:DatumUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-436"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56106" /><g2o:inhalt>mit gmeyner urphet</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Urfehdeeid rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-436"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-436" /></uf:Urfehdeeid><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeStrafumwandlung-12"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56106" /><g2o:inhalt>nochdem Hanss Gassman, sin meister 5 lb stroff für in zeentrichten zuogseyt,</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeStrafumwandlung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeStrafumwandlung-StrafeStrafumwandlung-12"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeStrafumwandlung-12" /></uf:StrafeStrafumwandlung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-206"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56106" /><g2o:inhalt>hiemit gewarnet, das er hinfürter sich by zyten ab der gassen thuon solle.</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeErmahnung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-206"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-206" /></uf:StrafeErmahnung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-428"><g2o:appears-on rdf:resou