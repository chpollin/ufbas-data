f:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1061" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-542"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-542" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1061" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-1061"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e70857" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-1061"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-1061" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-567"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e70857" /><g2o:inhalt>Eselthurn – 1 °Hans Köchlj von Zürich dess nochrichters diener Alsdann im befolchen das er den unrath uff der Byrss, im nassen fang solle fürschalten, hatt er dasselb nit erstattet, sonder mit dem süwhirten balget, das er im entlouffen müssen, desshalben er inn gfenckniss dess Esellthurns gleyt, und uff Zinstag den 24 meygens ditz 69 jars, mit gmeyner urphet wider ussglossen, und im darby anzeigt, das er hinfürt, den unrath fürschalten solle. NiclausIm Hoffsubscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-567"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-567" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnoti