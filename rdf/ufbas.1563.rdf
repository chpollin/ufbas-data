                        </uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-855" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-855"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56106" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-855"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-855" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-455"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>Rorer - 1 Uolin - 1 ° Jocob Schoub von Wytissberg und ° Barbell Ackermannj von Zuntzgen Die Herren Eerichter haben sy beyde inn gfenckniss lossen legen , Jocoben Schoub umb 5 lb und bemelte Barbell umb zwen gulden gstrofft, diewyl er hinderrucks irer eltern gehandlet, und das sy den dicken pfennig zwölff wuchen behalten. Sindt uff Mittwochen den vierten ornungs ditz 68 jars, mit gmeyner urphet gnediglichen wider ussglossenn. Niclauss Im Hoff Notarius sub s cripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-455"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-455" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-440" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-441" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-539" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-540" /><uf:hasVorinstanz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-71" /><uf:hasStrafeGefän