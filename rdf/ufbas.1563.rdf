><uf:StrafeErmahnung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-17"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-17" /></uf:StrafeErmahnung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-30"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5358" /><g2o:inhalt>Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-30"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-30" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-30" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-30"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5358" /><g2o:inhalt>Niclauss Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-30"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-30" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-81" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-30"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-30" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-81" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-81"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5358" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-81"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-81" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-43"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5358" /><g2o:inhalt>Thoubhüsslin - 1 °Dorothe von Thono uss Saphoy ein gemeyne mëtz Diss gmeyne dyrn ist hinacht inn stall zuom Schnabell funden desshalben sy ins Thoubhüsslin gleyt, und uff Mentag den 24 Höwmonats ditz 64 jars mit gmeyner urphet, diewyl sy vor nie innglegen, gnediglichen wider ledig glossen, hatt darby ouch geschworen, das sy sich vonn statt und landt Basell hinweg thuon, und onerloupt, nit wider harin komen solle, by peen des schwemmens und halssysens. Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-43"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-43" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-26" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-49" /><uf:hasSchlagwortProstitution rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortProstitution-SchlagwortProstitution-1" /><uf:hasTatVagieren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatVagieren-TatVagieren-2" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-34" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-37" /><uf:hasUrfehdeeid rdf:resource