ce="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-215" /></uf:OrtTatort><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Lausen"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-215" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatBeihilfe-16"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e74775" /><g2o:inhalt>dann dieselben zwen, dem würt, über ein trog geprochen und ettlich gellt dorus entwert, ist diser uff einem pflumen boum gsessen, die zwen sine gsellen verhütet, dorumb sy ouch im für sinen theyl, by drü oder vier pfunden geben</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatBeihilfe rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatBeihilfe-TatBeihilfe-16"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatBeihilfe-16" /></uf:TatBeihilfe><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#placeName-1030"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e74775" /><g2o:inhalt>Liechstall</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Liestal"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#placeName-1030" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-555"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e74775" /><g2o:inhalt>gfencklichen ergriffen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-555"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-555" /></uf:Untersuchungshaft><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfehdeverfahren-42"><g2o:appears-on rdf:reso