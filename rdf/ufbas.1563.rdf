                        </uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Onay" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-414"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>Ryney by Grey inn Burgundt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Onay"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-414" /></uf:OrtHerkunft><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Onay"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-414" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-173"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>Gelterkingen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtTatort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Gelterkinden"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-173" /></uf:OrtTatort><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Gelterkinden"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-173" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-53"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>truncken</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatAlkoholmissbrauch rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-TatAlkoholmissbrauch-53"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-53" /></uf:TatAlkoholmissbrauch><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-76"><g2o:appears-on rdf:res