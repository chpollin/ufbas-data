olffen anrichten, und under der Linden tantzt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatOrdnungsstörung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-TatOrdnungsstörung-42"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-42" /><uf:hasPersonMittäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonMittäter-PersonMittäter-61" /></uf:TatOrdnungsstörung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonMittäter-61"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38488" /><g2o:inhalt>nochrichter von Rinfelden</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonMittäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonMittäter-PersonMittäter-61"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonMittäter-61" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-581" /></uf:PersonMittäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonMittäter-61"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonMittäter-61" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-581" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-581"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38488" /><g2o:inhalt>nochrichter</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-581"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-581" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-35"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38488" /><g2o:inhalt>Augustin Steck der vogt</g2o:inhalt><g2o:isPartOf 