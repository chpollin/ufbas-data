tion rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-46"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5055" /><g2o:inhalt>Susanna Sorgerj °sin eefrouw.</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-46"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-46" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Susanna</uf:forename><uf:surname>Sorgerj</uf:surname><uf:hasVerwandtschaftsgrad rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-Verwandtschaftsgrad-3" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-46"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-46" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Susanna</uf:forename><uf:surname>Sorgerj</uf:surname><uf:hasVerwandtschaftsgrad rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-Verwandtschaftsgrad-3" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-3"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5055" /><g2o:inhalt>sin eefrouw</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Verwandtschaftsgrad rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-Verwandtschaftsgrad-3"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-3" /></uf:Verwandtschaftsgrad><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-2"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5055" /><g2o:inhalt>sy beyde inn irem huss Anna Biebin genant SchlacherinAnna Biebin genant Schlacherin kommt in anderen Urfehdeverfahren vor, siehe Urfehdeeinträge Peter vom Ryet der stattknecht (fol. 15 recto), Anna Biebin genant Schlacherin (fol. 15 verso) und Barbell Bart Clausen Schwertzig des huotmachers eefrow (fol. 16 recto) für andere Urfehdeverfahren, uffenthallt geben, frü und spot by inen zeren und prassen lossen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatLeichtfertigkeit rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-TatLeichtfertigkeit-2"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-2" /><uf:hasOrtTatort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-OrtTatort-27" /><uf:hasPersonAnwesende rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-PersonAnwesende-3" /></uf:TatLeichtfertigkeit><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-27"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5055" /><g2o:inhalt>inn irem huss</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtTatort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-OrtTatort-27"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-27" /></uf:OrtTatort><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Ort-OrtTatort-27"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtTatort-27" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-3"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e5055" /><g2o:inhalt>Anna Biebin genant Schlacherin</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonAnwesende rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-PersonAnwesende-3"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonAnwesende-3" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:fo