er</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-576"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-576" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-26"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38097" /><g2o:inhalt>er im sturm als es im Werckhoff brunnen, doheym plyben und nit zuom fënlj, zuo siner zunfft kommen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatUngehorsam rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-TatUngehorsam-26"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUngehorsam-26" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Ort-placeName-526" /><uf:hasSchlagwortZunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-SchlagwortZunft-34" /></uf:TatUngehorsam><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#placeName-526"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38097" /><g2o:inhalt>Werckhoff brunnen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Ort-placeName-526"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#placeName-526" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-34"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e38097" /><g2o:inhalt>zunfft</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortZunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-SchlagwortZunft-34"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortZunft-34" /></uf:SchlagwortZunft><rdf:Description 