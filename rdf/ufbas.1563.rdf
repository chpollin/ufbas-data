23"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e42105" /><g2o:inhalt>und als Meister Jerg Spörlin der + rhatsher kommen, und gsagt, es were kein balg huss do, sindt sy an in geroten, also das einer von Muttentz noch dem Ratsherren geschlagen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatKörperverletzung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatKörperverletzung-TatKörperverletzung-23"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatKörperverletzung-23" /><uf:hasPersonOpfer rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-150" /></uf:TatKörperverletzung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-150"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e42105" /><g2o:inhalt>Meister Jerg Spörlin der + rhatsher</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonOpfer rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-150"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-150" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Jerg</uf:forename><uf:surname>Spörlin</uf:surname><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-77" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-634" /></uf:PersonOpfer><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonOpfer-150"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-150" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Jerg</uf:forename><uf:surname>Spörlin</uf:surname><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-77" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-634" /></uf:Person><rdf:Description rdf:about="h