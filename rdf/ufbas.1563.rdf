<g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-960"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-960" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-509"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e63526" /><g2o:inhalt>Brucker - 1 ° Cuontz Guoten von Dornach Die Herren Eerichter haben in übernacht inn gfenckniss legen, lassen von wegen das er Rosina Schmidin von Kötzingen, die dienstmagt Zuom Rappen der ee angsprochen, und aber er hiezwüschen siner dienst magt im huss ein kindt gmacht.Ist uff den 18 Augstmonats, ditz 68 jars,mit gmeyner urphet, wider ussglossenn. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-509"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-509" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-503" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-607" /><uf:hasVorinstanz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-84" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-470" /><uf:hasTatBruchEheversprechen rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatBruchEheversprechen-TatBruchEheversprechen-9" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-497" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-494" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-484" /></uf:Eintrag>