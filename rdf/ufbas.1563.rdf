><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortWirtshaus rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWirtshaus-SchlagwortWirtshaus-72"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWirtshaus-72" /></uf:SchlagwortWirtshaus><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-447"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e60657" /><g2o:inhalt>gfencklichen angnommen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-447"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-447" /></uf:Untersuchungshaft><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-76"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e60657" /><g2o:inhalt>Syben herren</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortSiebnerherren rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-SchlagwortSiebnerherren-76"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-76" /></uf:SchlagwortSiebnerherren><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortKeinGeständnis-17"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e60657" /><g2o:inhalt>nützit gwüsst</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortKeinGeständnis rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortKeinGeständnis-SchlagwortKeinGeständnis-17"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortKeinGeständnis-17" /></uf:SchlagwortKeinGeständnis><rdf:Description rdf:about="http://gams.uni-graz.at/