as er sich der Byrss tag und nacht, frü und spot, gëntzlichen aller dingen müssigen und abthuon solle</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeErmahnung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-164"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-164" /></uf:StrafeErmahnung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-341"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-341"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-341" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-342" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-342"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Niklaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-342"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-342" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-698" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-342"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-342" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-698" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-698"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-698"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-698" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-365"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Hanss Rorer – 1 ° Hans Schott der scherer inn mindren Basell Ist von sines liederlichen, unnützen und üblen husshaltens wegen, das er sin eefrowen die inn schwërer anfëchtung und plödigkeit irer synnen ist, wenig betrachtet, sonder hin und wider zücht zetëmpffen und zefüllen, und inn sin husshaltung nützit kommen lasst. Inn gfenckniss gleyt und uff den vierten tag Julij ditz 67 jars, mit gmeyner urphet gnediglichen wider usglossen. Hatt darby ouch geschworen, das er sich nun hinfürter inn ein andere und bessere husshaltung dann bisshar schicken, böser gesellschafft sich abthuon, und wann man im hinfürter für unser Gnedig Herren, oder die Bannherren bütet, das er gehorsam sin solle. Niklaus Im Hoff der Statt Basell Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-365"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-365" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-349" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-436" /><uf:hasTatÜblesHaushalten rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatÜblesHaushalten-TatÜblesHaushalten-29" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-340" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-354" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-350" /><uf:hasStrafeErmahnung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-165" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-342" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-349"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Hanss Rorer – 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-349"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-349" /><uf:hasSchlagwortRatsknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-SchlagwortRatsknecht-150" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-150"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Hanss Rorer</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortRatsknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-SchlagwortRatsknecht-150"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-150" /></uf:SchlagwortRatsknecht><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-SchlagwortRatsknecht-150"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-150" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-436"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>Hans Schott der scherer inn mindren Basell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-436"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-436" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Hans</uf:forename><uf:surname>Schott</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-699" /><uf:hasOrtWohnort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Kleinbasel" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-436"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-436" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Hans</uf:forename><uf:surname>Schott</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-699" /><uf:hasOrtWohnort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Kleinbasel" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-699"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>scherer</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-699"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-699" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtWohnort-65"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e46124" /><g2o:inhalt>mindren Basell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:u