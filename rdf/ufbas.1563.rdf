.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-101" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-23" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-24" /><uf:hasTatUnzucht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUnzucht-TatUnzucht-8" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-109" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-105" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-104" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-100"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e14812" /><g2o:inhalt>Uolj - 1 Brucker - 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-100"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-100" /><uf:hasSchlagwortStadtknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-29" /><uf:hasSchlagwortObersterKnecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortObersterKnecht-SchlagwortObersterKnecht-25" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-29"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e14812" /><g2o:inhalt>Uolj</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortStadtknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-29"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-29" /></