tion rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-55"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e14812" /><g2o:inhalt>das er sich nachts by zyten ab der gassen thun solle</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeErmahnung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-55"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-55" /></uf:StrafeErmahnung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-103"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e14812" /><g2o:inhalt>Niclaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-103"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-103" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-102" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-102"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e14812" /><g2o:inhalt>Niclaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-102"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-102" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-227" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-102"><oa:hasTarget rdf:resource=