gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-106"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-106" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Claus</uf:forename><uf:surname>Ecklin</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Fischingen" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-106"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-106" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Claus</uf:forename><uf:surname>Ecklin</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Fischingen" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-86"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e11420" /><g2o:inhalt>Vischingen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Fischingen"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-86" /></uf:OrtHerkunft><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Fischingen"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-86" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumTat-15"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e11420" /><g2o:inhalt>gestrigen tag</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:DatumTat rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumTat-DatumTat-15"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumTat-15" /></uf:DatumTat><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfe