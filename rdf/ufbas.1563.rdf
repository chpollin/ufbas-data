</rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-74"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-74" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-73" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-73"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10989" /><g2o:inhalt>Niclaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-73"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-73" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-167" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-73"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-73" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-167" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-167"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10989" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-167"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-167" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-86"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10989" /><g2o:inhalt>Thoubhüslj - 2 ° Margreth Kellerj von Münster uss Lutzern pieth und Margreth ° Neserj von Bern Dise zwo gmeynen metzen, sindt von ires onerloupten, erger lichen lebens wegen, ins Toubhüslin gleyt, und uff Mentag den 13 Novembris ditz 64 jars, mit gmeynder urphet gnediglichen wider ussglossen habent dorby ouch sampt und sonders geschworen, das sy sich von statt und landt Basell hinweg thuon, und darin onerloupt nit wider kommen sollen, by peen des halsysens und schwemmens. Niclaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-86"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-86" /><uf:surname>Neserj</uf:surname><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-71" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-102" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-103" /><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Bern" /><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-168" /><uf:hasTatLeichtfertigkeit rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-TatLeichtfertigkeit-6" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-77" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-80" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-77" /><uf:hasStrafeAusweisung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-StrafeAusweisung-30" /><uf:hasStrafeStrafandrohung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeStrafandrohung-StrafeStrafandrohun