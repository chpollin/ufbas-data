y vier wochen ghept, und ouch ein welscher ist, der sich Wilhelm nempt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatLeichtfertigkeit rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-TatLeichtfertigkeit-4"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatLeichtfertigkeit-4" /><uf:hasSchlagwortSpital rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSpital-SchlagwortSpital-1" /><uf:hasSchlagwortWelsche rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWelsche-SchlagwortWelsche-3" /><uf:hasPerson rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-242" /></uf:TatLeichtfertigkeit><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSpital-1"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e7396" /><g2o:inhalt>spittal</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortSpital rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSpital-SchlagwortSpital-1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSpital-1" /></uf:SchlagwortSpital><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWelsche-3"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e7396" /><g2o:inhalt>welscher</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortWelsche rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWelsche-SchlagwortWelsche-3"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWelsche-3" /></uf:SchlagwortWelsche><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#persName-242"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e7396" /><g2o:inhalt>Wilhelm</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf: