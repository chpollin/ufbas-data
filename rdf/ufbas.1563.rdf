nNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-323" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-323"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Niclaus Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-323"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-323" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-661" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-323"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-323" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-661" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-661"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-661"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-661" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-345"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Thoubhüslin – 1 °Elssbeth Trölerj von Bern Diewyl diese gmeyne metz uff dem heyssen stein gsessen und mit wyn überladen gsin, ist sy ins Thoubhüslin gleyt und uff Mittwochen den 25ten Septembris ditz 66 jars mit gmeyner urphet gnediglichen wider ussglossen, hatt dorby auch geschworen das sy sich von statt und landt Basell hinweg thuon und darin onerloupt nit kommen soll by peen des halsysens und schwemmens. Niclaus Im Hoff Notariussubscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-345"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-345" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-329" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-414" /><uf:hasTatAlkoholmissbrauch rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-TatAlkoholmissbrauch-41" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-322" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-335" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-332" /><uf:hasStrafeAusweisung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-StrafeAusweisung-102" /><uf:hasStrafeStrafandrohung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeStrafandrohung-StrafeStrafandrohung-115" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-323" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-329"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Thoubhüslin – 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-329"><oa:hasTarget rdf:resource="http://gams.uni-