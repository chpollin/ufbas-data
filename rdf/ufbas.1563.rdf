n Murer burger inn Mindren Basell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-210"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-210" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Maximian</uf:forename><uf:surname>Murer</uf:surname><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-54" /><uf:hasOrtWohnort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Kleinbasel" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-210"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-210" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Maximian</uf:forename><uf:surname>Murer</uf:surname><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-54" /><uf:hasOrtWohnort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Kleinbasel" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Status-54"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e22816" /><g2o:inhalt>burger</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Status rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-54"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-54" /></uf:Status><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtWohnort-38"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e22816" /><g2o:inhalt>Mindren Basell</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtWohnort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Kleinbasel"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtWohnort-38" /></uf:OrtWohnort><u