sen-SchlagwortHalseisen-13"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortHalseisen-13" /></uf:SchlagwortHalseisen><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRuten-7"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>ruoten</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortRuten rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRuten-SchlagwortRuten-7"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRuten-7" /></uf:SchlagwortRuten><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-127"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:NotarialSubscription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-127"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-127" /><uf:hasPersonNotar rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-126" /></uf:NotarialSubscription><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-126"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Niclauss Im Hoff Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-126"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-126" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-278" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-126"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-126" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclauss</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-278" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-278"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-278"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-278" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-140"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Thoubhüslj - 1 ° Elsbeth Belgeri, Batt Ziegler genant Karrenböcklins eefrouw Diewyl sy zuo Bynningen gsin, sich mit wyn überladen, und by Eschamer thurn an ettlich mannen geroten, mit schlüsslen umb sich geschlagen, ein wyldt geschrey ghept, das ein gestëndt von lüthen umb sy gsin, als ob es ein merwunder were, ist sy inn gfenckniss gfürt, und uff Mittwoch den nündten May ditz 65 jars mit gmeiner urphet gnediglichen wider ussglossen, hatt darby ouch geschworen, das sy hinfürter sollicher sachen abston, desglichen Gregorius von Kilchen zeruowen und friden und onüberlassen solle lassen. Niclauss Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-140"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-140" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-117" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-168" /><uf:hasOrtTatort rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Binningen" /><uf:hasTatAlkoholmissbrauch rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-TatAlkoholmissbrauch-17" /><uf:hasTatOrdnungsstörung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatOrdnungsstörung-TatOrdnungsstörung-19" /><uf:hasSchlagwortMeerwunder rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortMeerwunder-SchlagwortMeerwunder-1" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-125" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-133" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-130" /><uf:hasStrafeErmahnung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-64" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-128" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-117"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Thoubhüslj - 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-117"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-117" /><uf:hasSchlagwortGefängnis rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-SchlagwortGefängnis-51" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-51"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Thoubhüslj</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortGefängnis rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-SchlagwortGefängnis-51"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortGefängnis-51" /></uf:SchlagwortGefängnis><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-168"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Elsbeth Belgeri, Batt Ziegler genant Karrenböcklins eefrouw</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-168"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-168" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Elsbeth</uf:forename><uf:surname>Belgeri</uf:surname><uf:hasPerson rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-562" /><uf:hasVerwandtschaftsgrad rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-Verwandtschaftsgrad-14" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-168"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-168" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Elsbeth</uf:forename><uf:surname>Belgeri</uf:surname><uf:hasPerson rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-562" /><uf:hasVerwandtschaftsgrad rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Verwandtschaftsgrad-Verwandtschaftsgrad-14" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#persName-562"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e18124" /><g2o:inhalt>Batt Ziegler genant Karrenböcklins</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Person rdf:about="http://gams.un