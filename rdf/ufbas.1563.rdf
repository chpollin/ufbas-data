iz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-367" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-459" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-460" /><uf:hasVorinstanz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-56" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-357" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-114" /><uf:hasTatUnzucht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUnzucht-TatUnzucht-40" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-372" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-368" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-360" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-367"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040" /><g2o:inhalt>Uolj -1 Brucker – 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-367"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-367" /><uf:hasSchlagwortStadtknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-113" /><uf:hasSchlagwortObersterKnecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortObersterKnecht-SchlagwortObersterKnecht-101" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-113"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48040"