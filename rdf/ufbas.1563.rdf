lichen angnommen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-388"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-388" /></uf:Untersuchungshaft><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-404"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e51969" /><g2o:inhalt>Mittwochen den 29 Octobris ditz 67ten jars</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:DatumUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-404"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-404" /><tei:when>1567-10-29</tei:when></uf:DatumUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-400"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e51969" /><g2o:inhalt>mit gmeyner urphet, die sy geschworen, wider ledig glossen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Urfehdeeid rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-400"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-400" /></uf:Urfehdeeid><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#persName-1682"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e51969" /><g2o:inhalt>Meister Heinrich der oberst knecht</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-1682"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#persName-1682" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Heinrich</uf:forename><uf:hasStatus rdf:resource="