us</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-821" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-821"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e54350" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-821"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-821" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-437"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e54350" /><g2o:inhalt>Rorer – 1 ° Lentz Bidermann von Zuntzgen Die Herren Eerichter, haben in übernacht inn gfenckniss legen lossen und umb 5 lb gstrofft, von wegen das er Barblen Fy, von Zuntzgen, inn ires vatters huss nochgangen, und aber der ee halben, den eydt für sy schweren wollen, ist uff Mittwochen den 14 Jenners ditz 68 jars, mit gmeyner urphet gnediglichen wider ussglossen. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-437"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-437" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-422" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-518" /><uf:hasVorinstanz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-66" /><uf:hasStrafeGeldstrafe rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeGeldstrafe-StrafeGeldstrafe-132" /><uf:hasPersonOpfer rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-181" /><uf:hasTatLeichtfertigkeit rdf:resource="http://gams.uni-graz.at/