rfahren-10" /></uf:FrüheresUrfehdeverfahren><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-17"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e8983" /><g2o:inhalt>das er ein ross solte entwert haben</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatDiebstahl rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-TatDiebstahl-17"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatDiebstahl-17" /></uf:TatDiebstahl><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUnrechtmässigesEheversprechen-1"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e8983" /><g2o:inhalt>ein eefrowen gnommen solte han</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatUnrechtmässigesEheversprechen rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatUnrechtmässigesEheversprechen-TatUnrechtmässigesEheversprechen-1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatUnrechtmässigesEheversprechen-1" /></uf:TatUnrechtmässigesEheversprechen><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-34"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e8983" /><g2o:inhalt>Jocoben Günthart genant Friess, siner kinden vogt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonOpfer rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-34"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-34" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Jocoben</uf:forename><uf:surname>Günthart</uf:surname><uf:hasBeiname rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beiname-Beiname-10" /><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-14" /></uf:PersonOpfer><uf:Person rdf:about