            burg</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-500" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-500"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e33777" /><g2o:inhalt>Juncker</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-500"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-500" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-27"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e33777" /><g2o:inhalt>ein unpartyesch gericht, gon Buss, Meysperach und Winter singen, angesetzt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Vorinstanz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-Vorinstanz-27"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Vorinstanz-27" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Buus" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Maisprach" /><uf:hasOrt rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Wintersingen" /></uf:Vorinstanz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#placeName-458"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e33777" /><g2o:inhalt>Buss</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Buus"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#placeName-458" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#placeName-459"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e33777" /><g2o:inhalt>Meysperach</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1