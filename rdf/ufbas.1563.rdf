ndt Basell hinweg thuon, und innerthalb solchen zechen mylen sich nit finden solle lassen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:StrafeAusweisung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-StrafeAusweisung-123"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-123" /><uf:hasSchlagwortAuffällig rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-SchlagwortAuffällig-79" /></uf:StrafeAusweisung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-79"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e49632" /><g2o:inhalt>zechen myl</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortAuffällig rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-SchlagwortAuffällig-79"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-79" /></uf:SchlagwortAuffällig><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-80"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e49632" /><g2o:inhalt>inn bysin Meister Hanssen Rorer des rhatsknechts</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortAuffällig rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-SchlagwortAuffällig-80"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-80" /><uf:hasSchlagwortRatsknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-SchlagwortRatsknecht-161" /></uf:SchlagwortAuffällig><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-161"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e49632" /><g2o:inhalt>Meister Hanssen Rorer des rhatsknechts</g2o:inhalt><g2o:isPartOf rdf:resourc