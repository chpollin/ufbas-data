fbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-325"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-325" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-664" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-325"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-325" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niclaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-664" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-664"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-664"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-664" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-347"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Bylger - 1 °Sigmundt Rüwelj von Carsouw by Bücken glegen Diewyl dieser junger gsell so nit uber sechszechen jar alt, ein tag oder acht hie inn der statt umbher zogen, den Kuontzen gejagt, und sich dess goucklens angnommen ist er inn gfenckniss gleyt, und uff Mentag den 23 Septembris diss 66 jars mit gmeyner urphet gnediglichen wider ussglossen, hatt darby auch geschworen, das er sich von statt und landt Basell hinweg thuon, und darin onerloupt nit kommen solle. Niclaus Im Hoff Notariussubscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-347"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-347" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-331" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-416" /><uf:hasSchlagwortAuffällig rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-SchlagwortAuffällig-67" /><uf:hasTatVagieren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatVagieren-TatVagieren-6" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-324" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-337" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-334" /><uf:hasStrafeAusweisung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeAusweisung-StrafeAusweisung-103" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-325" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-331"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2o:inhalt>Bylger - 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eingangsnotiz rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-331"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-331" /><uf:hasSchlagwortRatsknecht rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-SchlagwortRatsknecht-141" /></uf:Eingangsnotiz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-141"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e44086" /><g2