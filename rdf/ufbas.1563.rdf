df:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-282"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>Johannes Fry von Rorenfelss by Nüwenburg an der Thonow glegen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-282"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-282" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Johannes</uf:forename><uf:surname>Fry</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Rohrenfels" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-282"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-282" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Johannes</uf:forename><uf:surname>Fry</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Rohrenfels" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-213"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>Rorenfelss by Nüwenburg an der Thonow</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Rohrenfels"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-213" /></uf:OrtHerkunft><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Rohrenfels"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-213" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-49"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e30899" /><g2o:inhalt>Die universitet</g2o:inhalt><g2o:isPartOf rdf:resource="http: