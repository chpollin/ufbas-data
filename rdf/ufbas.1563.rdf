n rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e71589" /><g2o:inhalt>Ylidorffer</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortRatsknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-SchlagwortRatsknecht-239"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-239" /></uf:SchlagwortRatsknecht><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-SchlagwortRatsknecht-239"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-239" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-695"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e71589" /><g2o:inhalt>Eva Wyss von Zürich</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-695"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-695" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Eva</uf:forename><uf:surname>Wyss</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Zürich" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-695"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-695" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#female" /><uf:forename>Eva</uf:forename><uf:surname>Wyss</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Zürich" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-511"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e71589" /><g2o:inhalt>Zürich</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:abo