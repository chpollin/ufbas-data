alt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonNotar rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-PersonNotar-368"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-368" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-738" /></uf:PersonNotar><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonNotar-368"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonNotar-368" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Niklaus</uf:forename><uf:surname>Im Hoff</uf:surname><uf:hasBeruf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-738" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-738"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48856" /><g2o:inhalt>Notarius</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Beruf rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Beruf-Beruf-738"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Beruf-738" /></uf:Beruf><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-391"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48856" /><g2o:inhalt>Brucker - 1 ° Ludj HütschinLudj Hütschin kommt in einem anderen Urfehdeverfahren vor, siehe Urfehdeeintrag Hans Schmid sesshaft uff Bruoderholtz (fol. 73 verso) für anderes Urfehdeverfahren Demnoch Jacob Hütschin selig, diesen jungen knaben, mit im uss dem krieg procht und in erzogen, ist er gantz muotwillig, und ongehorsam, will nienen plyben, desshalben er inn gfenckniss gleyt, und nochdem er durch die Syben Herren verhört, und sich erpotten er welle sinem vogt Hern Hanssen Gërnler vogt zuo Rammstein wann man in zuo einem handtwerck verdingen gehörig und gehorsam sin, hatt man in uff Sambstag den 13 des Septembris ditz 67 jars, mit gmeyner urphet wider ledig glossen. Niklaus Im Hoff Notarius subscripsit</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Eintrag rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-Eintrag-391"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eintrag-391" /><uf:hasEingangsnotiz rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-Eingangsnotiz-375" /><uf:hasPersonTäter rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-468" /><uf:hasPerson rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Person-persName-1592" /><uf:hasSchlagwortAuffällig rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortAuffällig-SchlagwortAuffällig-78" /><uf:hasTatMüssiggang rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatMüssiggang-TatMüssiggang-5" /><uf:hasUntersuchungshaft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-365" /><uf:hasSchlagwortSiebnerherren rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-SchlagwortSiebnerherren-59" /><uf:hasStrafeErmahnung rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#StrafeErmahnung-StrafeErmahnung-175" /><uf:hasDatumUrfehde rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-380" /><uf:hasUrfehdeeid rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-376" /><uf:hasNotarialSubscription rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#NotarialSubscription-NotarialSubscription-368" /></uf:Eintrag><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Eingangsnotiz-375"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e48856" /><g2o:inhalt>Brucker - 1</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf: