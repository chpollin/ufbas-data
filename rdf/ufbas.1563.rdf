escription rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-20"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>stattknecht</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortStadtknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-SchlagwortStadtknecht-20"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortStadtknecht-20" /></uf:SchlagwortStadtknecht><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDrohung-9"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>an bemelten Caspar geroten, wenn er im sin rebmesser wider gebe, wie im wäre, wenn er im die wynstrass wyther gmacht hätte, und damit im tröwt, habe den andren schenkell ouch zerverletzen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatDrohung rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatDrohung-TatDrohung-9"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatDrohung-9" /></uf:TatDrohung><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatÜbertretungUrfehde-9"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>das er sin vor vordrige urphet, gar wenig ghalten</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatÜbertretungUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatÜbertretungUrfehde-TatÜbertretungUrfehde-9"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatÜbertretungUrfehde-9" /></uf:TatÜbertretungUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-70"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>inn gfenckniss gleyt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-70"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-70" /></uf:Untersuchungshaft><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-74"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>Mittwochen den ersten Novembris ditz 64 jors</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:DatumUrfehde rdf:about="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-DatumUrfehde-74"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#DatumUrfehde-74" /><tei:when>1564-11-01</tei:when></uf:DatumUrfehde><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-13"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>Sybenherren</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortSiebnerherren rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-SchlagwortSiebnerherren-13"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortSiebnerherren-13" /></uf:SchlagwortSiebnerherren><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-71"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e10226" /><g2o:inhalt>gnediglichen wider ussglassen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Urfehdeeid rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-Urfehdeeid-71"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Urfehdeeid-71" /></uf:Urfehdeeid><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#StrafeVerbotWirtshaus-15"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1