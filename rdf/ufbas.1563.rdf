dt</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#St.Jean" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-195"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-195" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Claus</uf:forename><uf:surname>Ackerfundt</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#St.Jean" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-155"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e20939" /><g2o:inhalt>Missiua, uss Walliss von Sant Johans thal</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#St.Jean"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-155" /></uf:OrtHerkunft><uf:Ort rdf:about="http://gams.uni-graz.at/o:ufbas.1563#St.Jean"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-155" /></uf:Ort><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfehdeverfahren-13"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e20939" /><g2o:inhalt>Hanss Schmidt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:AnderesUrfehdeverfahren rdf:about="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfehdeverfahren-AnderesUrfehdeverfahren-13"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#AnderesUrfehdeverfahren-13" /></uf:AnderesUrfehdeverfahren><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortWirtshaus-25"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e20939" /><g2o:inhalt>Zuom Rösslin</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Schla