                    </uf:surname><uf:hasStatus rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-105" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Status-105"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>burger alhie</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Status rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Status-Status-105"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Status-105" /></uf:Status><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatÜblesHaushalten-36"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>liederlichen und übell husshaltet,</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatÜblesHaushalten rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatÜblesHaushalten-TatÜblesHaushalten-36"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatÜblesHaushalten-36" /></uf:TatÜblesHaushalten><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatSpielen-11"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>inn wincklen sytzt zespylen,</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatSpielen rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatSpielen-TatSpielen-11"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatSpielen-11" /></uf:TatSpielen><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatAlkoholmissbrauch-52"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e56605" /><g2o:inhalt>vom wyn toll unnd voll, heimkommen,</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatAlkoholmissbrauch rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatAl