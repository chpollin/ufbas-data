 /></uf:Vorinstanz><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortEhegerichtEherichter-1"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e512" /><g2o:inhalt>eerichter</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortEhegerichtEherichter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortEhegerichtEherichter-SchlagwortEhegerichtEherichter-1"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortEhegerichtEherichter-1" /></uf:SchlagwortEhegerichtEherichter><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-5"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e512" /><g2o:inhalt>in lossen inlegen</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:Untersuchungshaft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-Untersuchungshaft-5"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Untersuchungshaft-5" /></uf:Untersuchungshaft><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatVortäuschungFalscherTatsachen-0"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e512" /><g2o:inhalt>er sich beriempt hatt, er habe mit Anna Greber von Hiltispach, die Ueli Wegelin von Diessenhofen, den brotbecken, der ee angesprochen, unküsch + heit getrieben und zwüschen denselben ein grossen onwylen gmacht</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:TatVortäuschungFalscherTatsachen rdf:about="http://gams.uni-graz.at/o:ufbas.1563#TatVortäuschungFalscherTatsachen-TatVortäuschungFalscherTatsachen-0"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#TatVortäuschungFalscherTatsachen-0" /><uf:hasPersonOpfer rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonOpfer-PersonOpfer-6" /><uf:hasPersonOpfer rdf:resource=