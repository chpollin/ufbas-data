az.at/o:ufbas.1563#" /></rdf:Description><uf:SchlagwortRatsknecht rdf:about="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-SchlagwortRatsknecht-183"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-183" /></uf:SchlagwortRatsknecht><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-SchlagwortRatsknecht-183"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#SchlagwortRatsknecht-183" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-534"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e55479" /><g2o:inhalt>Bastean Schwytzer von Ditterten uss Wallenburger ampt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:PersonTäter rdf:about="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-PersonTäter-534"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-534" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Bastean</uf:forename><uf:surname>Schwytzer</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Titterten" /></uf:PersonTäter><uf:Person rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Person-PersonTäter-534"><oa:hasTarget rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#PersonTäter-534" /><uf:gender rdf:resource="http://gams.uni-graz.at/ufbas/#male" /><uf:forename>Bastean</uf:forename><uf:surname>Schwytzer</uf:surname><uf:hasOrtHerkunft rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#Titterten" /></uf:Person><rdf:Description rdf:about="http://gams.uni-graz.at/o:ufbas.1563#OrtHerkunft-408"><g2o:appears-on rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#d1e55479" /><g2o:inhalt>Ditterten uss Wallenburger ampt</g2o:inhalt><g2o:isPartOf rdf:resource="http://gams.uni-graz.at/o:ufbas.1563#" /></rdf:Description><uf:OrtHerkunft rdf:about="http://gams.uni-graz.at/o:ufbas.1563#Titterten"><oa:hasTarget r