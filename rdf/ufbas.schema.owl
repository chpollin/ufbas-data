    <rdfs:label xml:lang="en">OffenceNeglectedSupport</rdfs:label>
    <rdfs:label xml:lang="de">TatUnterlasseneHilfeleistung</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatUnzucht">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
