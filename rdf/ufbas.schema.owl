    <rdfs:label xml:lang="de">TatLeichtfertigkeit</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatMord">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Absichtliche, heimtückische Tötung eines anderen</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceMurder</rdfs:label>
    <rdfs:label xml:lang="de">TatMord</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatMordversuch">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Versuchte absichtliche, heimtückische Tötung eines anderen</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceAttemptedMurder</rdfs:label>
    <rdfs:label xml:lang="de">TatMordversuch</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatMüssiggang">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Unmoralischer (und arbeitsscheuer) Lebenswandel, der nicht auf die Sicherung des eigenen Auskommens gerichtet ist, z.T. in Verbindung
            mit Vagieren</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceIdleness</rdfs:label>
    <rdfs:label xml:lang="de">TatMüssiggang</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatOrdnungsstörung">
