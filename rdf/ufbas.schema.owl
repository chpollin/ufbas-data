    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Missachtung eines früheren gegen dieselbe Person ergangenen Urfehdeurteils</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceInfringement </rdfs:label>
    <rdfs:label xml:lang="de">TatÜbertretungUrfehde</rdfs:label>
