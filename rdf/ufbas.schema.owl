    <rdfs:comment xml:lang="de">Selbstmordversuch</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceAttemptedSuicide</rdfs:label>
    <rdfs:label xml:lang="de">TatSelbstmordversuch</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatSpielen">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Unerlaubtes (Glücks)Spiel</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceGamble</rdfs:label>
    <rdfs:label xml:lang="de">TatSpielen</rdfs:label>
