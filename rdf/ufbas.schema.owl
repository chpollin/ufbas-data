    <rdfs:comment xml:lang="de">Störung der öffentlichen Ordnung</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceDisorder</rdfs:label>
    <rdfs:label xml:lang="de">TatOrdnungsstörung</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatSachbeschädigung">
