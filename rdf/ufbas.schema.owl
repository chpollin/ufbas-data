    <rdfs:label xml:lang="en">OffencePropertyDamage</rdfs:label>
    <rdfs:label xml:lang="de">TatSachbeschädigung</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatSchlägerei">
