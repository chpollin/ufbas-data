    <rdfs:label xml:lang="en">OffenceFight</rdfs:label>
    <rdfs:label xml:lang="de">TatSchlägerei</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatSchulden">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Schulden machen (meist jenseits der eigenen finanziellen Möglichkeiten)</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceDebts</rdfs:label>
    <rdfs:label xml:lang="de">TatSchulden</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatSelbstmordversuch">
