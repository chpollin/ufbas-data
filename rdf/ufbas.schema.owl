    <rdfs:label xml:lang="en">OffenceBreachWorkRules</rdfs:label>
    <rdfs:label xml:lang="de">TatVerstossArbeitsvorschriften</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatVeruntreuung">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Unterschlagung oder Hinterziehung von Geld</rdfs:comment>
    <rdfs:label xml:lang="en">Offence</rdfs:label>
    <rdfs:label xml:lang="de">TatVeruntreuung</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatVorteilsnahme">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Unrechtmässiges Verschaffen eines Vorteils</rdfs:comment>
    <rdfs:label xml:lang="en">OffencePersonalAdvantage</rdfs:label>
    <rdfs:label xml:lang="de">TatVorteilsnahme</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatVortäuschungFalscherTatsachen">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Vortäuschung falscher Tatsachen</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceUnderFalsePretences</rdfs:label>
    <rdfs:label xml:lang="de">TatVortäuschungFalscherTatsachen</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatWiderstandgegenObrigkeit">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Allgemeiner Widerstand gegen Amtsträger/Obrigkeit (kann auch politisch motiviert sein; Widersetzlichkeit gegen konkrete Anweisung wird
            als Ungehorsam kategorisiert)</rdfs:comment>
    <rdfs:label xml:lang="en">OffenceResistance</rdfs:label>
    <rdfs:label xml:lang="de">TatWiderstandgegenObrigkeit</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatWilderei">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
    <rdfs:comment xml:lang="de">Unrechtmässiges Jagen von Wild</rdfs:comment>
    <rdfs:label xml:lang="en">OffencePoaching</rdfs:label>
    <rdfs:label xml:lang="de">TatWilderei</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#TatZechprellerei">
    <rdfs:subClassOf rdf:resource="http://gams.uni-graz.at/ufbas/#Tat"></rdfs:subClassOf>
