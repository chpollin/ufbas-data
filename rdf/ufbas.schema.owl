    <rdfs:label xml:lang="en">OffenceBill-dodging</rdfs:label>
    <rdfs:label xml:lang="de">TatZechprellerei</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#Untersuchungshaft">
    <rdfs:comment xml:lang="de">Inhaftierung des Täters vor dem Urfehdeeid</rdfs:comment>
    <rdfs:label xml:lang="en">Custody</rdfs:label>
    <rdfs:label xml:lang="de">Untersuchungshaft</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#Urfehdeeid">
    <rdfs:comment xml:lang="de">Erwähnung des Urfehdeeides</rdfs:comment>
    <rdfs:label xml:lang="en">Oath of truce</rdfs:label>
    <rdfs:label xml:lang="de">Urfehdeeid</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#Verwandtschaftsgrad">
    <rdfs:comment xml:lang="de">Verwandtschaftsbeziehung einer Person zu einer anderen (Tochter, Enkel, Ehemann, Schwiegersohn/-tochter/-vater/-mutter
            etc.)</rdfs:comment>
    <rdfs:label xml:lang="en">Degree of relationship</rdfs:label>
    <rdfs:label xml:lang="de">Verwandtschaftsgrad</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#Vorinstanz">
    <rdfs:comment xml:lang="de">Instanz, die den Fall zuvor behandelt und die Untersuchungshaft der entsprechenden Person veranlasst hat</rdfs:comment>
    <rdfs:label xml:lang="en">Previous instance</rdfs:label>
    <rdfs:label xml:lang="de">Vorinstanz</rdfs:label>
  </Class>
  
  <Class rdf:about="http://gams.uni-graz.at/ufbas/#Zivilstand">
    <rdfs:comment xml:lang="en"></rdfs:comment>
    <rdfs:comment xml:lang="de">Familienstand (ledig, verheiratet, verwittwet, geschieden)</rdfs:comment>
    <rdfs:label xml:lang="en">Marital status</rdfs:label>
    <rdfs:label xml:lang="de">Zivilstand</rdfs:label>
  </Class>
  
  <rdf:Description rdf:about="http://gams.uni-graz.at/ufbas/#forename">
